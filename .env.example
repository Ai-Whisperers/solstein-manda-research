# M&A Research Pipeline — Environment Variables
# Copy to .env and fill in your keys (or export directly)

# === REQUIRED FOR FULL ENRICHMENT ===

# AbstractAPI Company Enrichment (free tier: 100 requests/mo)
# Sign up at https://www.abstractapi.com/api/company-enrichment
# Adds: employee count, revenue range, industry, LinkedIn URL, technologies
ABSTRACT_API_KEY=

# === OPTIONAL SOURCE ENRICHMENT ===

# GitHub personal access token (raises API limit from 60 to 5,000 req/hr)
# Create at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# UK Companies House API key (free, 600 req/5min)
# Register at: https://developer.company-information.service.gov.uk/
UK_COMPANIES_HOUSE_KEY=

# Financial Datasets API key (free tier)
# Sign up at: https://financialdatasets.ai/
FINANCIAL_DATASETS_API_KEY=

# === LLM / AGENT CONFIG ===

# OpenAI key (only needed for multi-agent CrewAI research)
OPENAI_API_KEY=

# LiteLLM proxy URL (already configured for VPS at 72.61.44.159:4000)
# LITELLM_URL=http://72.61.44.159:4000/v1
